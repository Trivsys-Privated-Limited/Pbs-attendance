# PBS Attend — environment variables (template). Never commit real values.
#
# Use ONLY the brand-new, dedicated PBS Attend Supabase project (or the local stack).
# NEVER copy URLs or keys from any other existing Supabase project.
#
# Where each block goes:
#   apps/admin/.env.local    -> "Admin web app" blocks
#   apps/desktop/.env.local  -> "Desktop app" block
# Both files are git-ignored.

# ===========================================================================
# Admin web app (apps/admin/.env.local)
# ===========================================================================

# --- Public values (safe for the browser) ----------------------------------
# Supabase Dashboard -> Project Settings -> API (or `supabase status` locally).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SERVER-ONLY secrets ------------------------------------------------------
# Bypasses RLS. Used only by trusted server code (login mapping, audit, throttling).
# Never prefix with NEXT_PUBLIC_, never put it in the desktop app, never log it.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret (>= 32 chars) that signs admin session stamps and pseudonymizes
# rate-limit keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Optional server settings --------------------------------------------------
# Internal (non-deliverable) email domain for employee Auth identities.
# Employees never see or use it; they sign in with Employee ID + password.
EMPLOYEE_AUTH_EMAIL_DOMAIN=employees.pbs-attend.internal
# Absolute maximum admin session age in hours (1-24).
ADMIN_SESSION_MAX_AGE_HOURS=12
# Set to true ONLY when deployed behind a reverse proxy that sets X-Forwarded-For.
# Enables per-IP login throttling. Leave false otherwise (the header is spoofable).
TRUST_PROXY_HEADERS=false
# Development only: show the fictional UI previews when no backend is configured.
# Ignored in production builds.
ALLOW_DEMO_PREVIEW=false

# --- One-time super admin bootstrap (pnpm --filter @pbs-attend/admin bootstrap:super-admin)
# Prefer setting these in the terminal session instead of saving them in a file.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# ===========================================================================
# Desktop app (apps/desktop/.env.local) — build-time, main process only
# ===========================================================================
# Base URL of the PBS Attend server (the admin app). HTTPS required except
# http://localhost / http://127.0.0.1 during development.
# The desktop app NEVER contains Supabase keys of any kind.
MAIN_VITE_PBS_ATTEND_API_URL=http://localhost:3000
