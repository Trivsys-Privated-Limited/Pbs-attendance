{
  "name": "pbs-attend",
  "version": "0.1.0",
  "private": true,
  "description": "PBS Attend — Smart Attendance. Clear Insights. Workforce attendance & activity management by PBS Digitals.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @pbs-attend/admin dev",
    "dev:desktop": "pnpm --filter @pbs-attend/desktop dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:admin": "pnpm --filter @pbs-attend/admin build",
    "build:desktop": "pnpm --filter @pbs-attend/desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm db:verify",
    "db:verify": "node supabase/tests/verify-schema.mjs",
    "test": "pnpm -r test",
    "preflight:env": "node scripts/preflight-env.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "supabase": "^3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
