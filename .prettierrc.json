{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "apps/admin/**",
      "options": {
        "tailwindStylesheet": "./apps/admin/src/app/globals.css",
        "tailwindFunctions": ["cn", "cva"]
      }
    },
    {
      "files": "apps/desktop/**",
      "options": {
        "tailwindStylesheet": "./apps/desktop/src/renderer/src/styles.css"
      }
    }
  ]
}
